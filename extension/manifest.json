{
  "manifest_version": 3,
  "name": "Red Flag Scanner",
  "version": "1.0.0",
  "description": "AI-powered Terms & Conditions risk analysis tool",
  "action": {
    "default_popup": "index.html",
    "default_title": "Red Flag Scanner"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
